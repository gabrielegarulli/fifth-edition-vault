{
  "name": "fifth-edition-vault",
  "version": "0.0.3",
  "description": "Fifth Edition Vault is a community extension. It is not made, endorsed or supported by Atlas VTT or Atlas Online. Support: github.com/gabrielegarulli/fifth-edition-vault/issues. SRD 5.2.1 catalogs and characters in your vault, rolled into Atlas VTT.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "lint": "eslint .",
    "lint:directory": "eslint --config eslint.directory.config.mjs --quiet .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "preflight": "node scripts/preflight.mjs"
  },
  "keywords": [
    "obsidian-plugin",
    "srd",
    "ttrpg",
    "fifth-edition"
  ],
  "author": "Gabriele Garulli",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gabrielegarulli/fifth-edition-vault.git"
  },
  "homepage": "https://github.com/gabrielegarulli/fifth-edition-vault",
  "dependencies": {
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.14.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.14.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.2.1",
    "eslint-plugin-obsidianmd": "^0.5.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.5.0",
    "jsdom": "^29.1.1",
    "obsidian": "^1.13.1",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.0.10",
    "vitest": "^4.1.5",
    "yaml": "^2.9.1"
  }
}
