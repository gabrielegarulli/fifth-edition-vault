filters:
  and:
    - file.ext == "md"
    - file.inFolder("SRD 5.2.1/spells")
views:
  - type: table
    name: All Spells
    order:
      - file.name
      - level
      - school
      - casting_time
      - concentration
      - ritual
      - edition
      - source
    indentProperties: false
  - type: cards
    name: Cards
    order:
      - file.name
      - level
      - school
      - classes
    indentProperties: false
