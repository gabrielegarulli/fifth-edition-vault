filters:
  and:
    - file.ext == "md"
    - file.inFolder("SRD 5.2.1/conditions")
views:
  - type: table
    name: All Conditions
    order:
      - file.name
      - edition
      - source
    indentProperties: false
  - type: cards
    name: Condition Cards
    order:
      - file.name
      - source
    indentProperties: false
