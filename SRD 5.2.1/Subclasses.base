filters:
  and:
    - file.ext == "md"
    - file.inFolder("SRD 5.2.1/subclasses")
views:
  - type: table
    name: All Subclasses
    order:
      - file.name
      - class
      - edition
      - subclass_title
      - source
    indentProperties: false
  - type: cards
    name: Subclass Cards
    order:
      - file.name
      - class
      - edition
    indentProperties: false
